# Copia este archivo a .env (solo para desarrollo local con `vercel dev`).
# En producción estas variables se configuran en Vercel > Settings > Environment Variables.

# URL del proyecto de Supabase, p. ej. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Llave secreta de Supabase: sirve la nueva (sb_secret_…) o la clásica service_role.
# Solo vive en las funciones serverless.
# NUNCA la pongas en index.html, sorteo.html ni en ningún archivo que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Token para abrir sorteo.html y consultar /api/participantes.
# Genera uno aleatorio: openssl rand -hex 24
ADMIN_TOKEN=
